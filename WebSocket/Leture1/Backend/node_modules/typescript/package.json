    },
    "type": "module",
    "preferUnplugged": true,
    "engines": {
        "node": ">=16.20.0"
    },
    "files": [
        "bin",
        "lib",
        "schemas",
        "dist",
        "vendor",
        "NOTICE.txt"
    ],
    "bin": {
        "tsc": "./bin/tsc"
    },
    "exports": {
        "./package.json": "./package.json",
        "./schemas/tsconfig.schema.json": "./schemas/tsconfig.schema.json",
        "./schemas/jsconfig.schema.json": "./schemas/jsconfig.schema.json",
        ".": "./lib/version.cjs",
        "./vscode": "./dist/vscode/extensionApi.js",
        "./sync": "./dist/api/sync/api.js",
        "./async": "./dist/api/async/api.js",
        "./fs": "./dist/api/fs.js",
        "./path": "./dist/api/typedPaths.js",
        "./proto": "./dist/api/proto.js",
        "./ast": "./dist/ast/index.js",
        "./ast/is": "./dist/ast/is.js",
        "./ast/factory": "./dist/ast/factory.generated.js",
        "./ast/utils": "./dist/ast/utils.js",
        "./ast/scanner": "./dist/ast/scanner.js",
        "./ast/visitor": "./dist/ast/visitor.js",
        "./ast/clone": "./dist/ast/clone.js"
    },
    "imports": {
        "#getExePath": "./lib/getExePath.js",
        "#enums/*": {
            "types": "./dist/enums/*.enum.d.ts",
            "default": "./dist/enums/*.js"
        },
        "#vscode-jsonrpc/node": "./vendor/vscode-jsonrpc/lib/node/main.js"
    },
